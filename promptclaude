### Teste Unitário
```java
package com.ruan.fincore.service;
import com.ruan.fincore.dto.account.*;
import com.ruan.fincore.entity.*;
import com.ruan.fincore.enums.*;
import com.ruan.fincore.exception.*;
import com.ruan.fincore.repository.*;
import org.junit.jupiter.api.*;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.*;
import org.mockito.junit.jupiter.MockitoExtension;
import java.math.BigDecimal;
import java.util.*;
import static org.assertj.core.api.Assertions.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class AccountServiceTest {
    private static final UUID USER_ID = UUID.fromString("00000000-0000-0000-0000-000000000001");
    @Mock private AccountRepository accountRepository;
    @Mock private UserService userService;
    @InjectMocks private AccountService accountService;
    private User user;

    @BeforeEach void setUp() { user = new User(); user.setId(USER_ID); user.setEmail("test@example.com"); user.setRole(Role.USER); }

    @Test void listShouldReturnAccounts() {
        Account a = new Account(); a.setId(UUID.randomUUID()); a.setName("Nubank"); a.setType(AccountType.CHECKING); a.setBalance(BigDecimal.valueOf(1000)); a.setUser(user);
        when(userService.findByEmail("test@example.com")).thenReturn(user);
        when(accountRepository.findByUserIdOrderByName(USER_ID)).thenReturn(List.of(a));
        List<AccountResponse> r = accountService.list("test@example.com");
        assertThat(r).hasSize(1);
        assertThat(r.get(0).name()).isEqualTo("Nubank");
    }

    @Test void createShouldSaveAccount() {
        when(userService.findByEmail("test@example.com")).thenReturn(user);
        when(accountRepository.existsByNameIgnoreCaseAndUserId("Inter", USER_ID)).thenReturn(false);
        when(accountRepository.save(any(Account.class))).thenAnswer(inv -> inv.getArgument(0));
        AccountRequest req = new AccountRequest("Inter", AccountType.SAVINGS, BigDecimal.valueOf(500));
        AccountResponse r = accountService.create("test@example.com", req);
        assertThat(r.name()).isEqualTo("Inter");
    }

    @Test void createShouldThrowWhenNameExists() {
        when(userService.findByEmail("test@example.com")).thenReturn(user);
        when(accountRepository.existsByNameIgnoreCaseAndUserId("Nubank", USER_ID)).thenReturn(true);
        AccountRequest req = new AccountRequest("Nubank", AccountType.CHECKING, BigDecimal.ZERO);
        assertThatThrownBy(() -> accountService.create("test@example.com", req))
            .isInstanceOf(BusinessException.class).hasMessage("Já existe uma conta com este nome");
    }
}
